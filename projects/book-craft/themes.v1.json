  "canonical_breakpoints": {
    "desktop": 1440,
    "tablet": 834,
    "phone": 390
  },
  "invariant_rules": [
    "preserve canonical face identity",
    "preserve product structure and CTA hierarchy",
    "character and environment remain separate assets",
    "all themes support desktop/tablet/phone crop strategy",
    "motion obeys reduced-motion and performance budgets"
  ],
  "motion_profiles": {
    "core": {
      "ambient_particles": false,
      "parallax": false,
      "eye_shimmer": false,
      "cta_runner": "static-accent"
    },
    "premium": {
      "ambient_particles": "sparse",
      "parallax": "low",
      "eye_shimmer": "occasional",
      "cta_runner": "4-6s"
    },
    "signature": {
      "ambient_particles": "bounded",
      "parallax": "low-to-medium",
      "eye_shimmer": "occasional",
      "cta_runner": "4-6s",
      "hud_drift": "slow"
    }
  },
