{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father.local/schemas/interaction-contract.schema.json",
  "title": "Makar Interaction Contract",
  "type": "object",
  "required": [
    "interaction_id",
    "label",
    "kind",
    "target",
    "states",
    "status"
  ],
  "properties": {
    "interaction_id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "route",
        "action",
        "toggle",
        "modal",
        "external",
        "decorative"
      ]
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "wired",
        "verified",
        "disabled",
        "decorative"
      ]
    },
    "states": {
      "type": "object",
      "required": [
        "idle",
        "hover",
        "pressed",
        "focus",
        "disabled"
      ],
      "properties": {
        "idle": {
          "type": "string"
        },
        "hover": {
          "type": "string"
        },
        "pressed": {
          "type": "string"
        },
        "focus": {
          "type": "string"
        },
        "disabled": {
          "type": "string"
        },
        "loading": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "motion_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "analytics_event": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
