{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father.local/schemas/school-graph.schema.json",
  "title": "ALINA School Graph",
  "type": "object",
  "required": [
    "id",
    "version",
    "nodes",
    "edges"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "domain",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "graduate-standard",
              "competency",
              "skill",
              "knowledge",
              "tool",
              "pattern",
              "anti-pattern",
              "lesson",
              "exercise",
              "lab",
              "project",
              "assessment",
              "evidence",
              "source"
            ]
          },
          "title": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "active",
              "deprecated",
              "superseded"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "targetLevel": {
            "enum": [
              "K0",
              "K1",
              "K2",
              "K3",
              "K4",
              "K5",
              "K6"
            ]
          },
          "difficulty": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "source",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "requires",
              "prerequisite-of",
              "consists-of",
              "teaches",
              "practices",
              "verifies",
              "evidenced-by",
              "contributes-to",
              "related-to",
              "supersedes"
            ]
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "targetLevel": {
            "enum": [
              "K0",
              "K1",
              "K2",
              "K3",
              "K4",
              "K5",
              "K6"
            ]
          },
          "critical": {
            "type": "boolean"
          },
          "weights": {
            "type": "object",
            "properties": {
              "importance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "prerequisite": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "skill": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "assessment": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "recency": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "transfer": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}