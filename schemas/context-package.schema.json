{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father.local/schemas/context-package.schema.json",
  "title": "ALINA Agent Context Package",
  "type": "object",
  "required": [
    "task_id",
    "agent_id",
    "goal",
    "why",
    "priority",
    "status",
    "constraints",
    "inputs",
    "knowledge_refs",
    "project_decisions",
    "data_contracts",
    "visual_refs",
    "acceptance_criteria",
    "test_contract",
    "deliverables",
    "dependencies",
    "open_questions",
    "output_format",
    "context_version"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "why": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "blocked",
        "in_progress",
        "review",
        "done"
      ]
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "knowledge_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "project_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_contracts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visual_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_contract": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_format": {
      "type": "object",
      "additionalProperties": true
    },
    "context_version": {
      "type": "string"
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}