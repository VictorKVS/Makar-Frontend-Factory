{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father.local/schemas/visual-production-handoff.schema.json",
  "title": "FATHER Visual Production Handoff",
  "description": "Typed handoff from visual design/Figma into Makar production frontend.",
  "type": "object",
  "required": [
    "handoff_id",
    "project_id",
    "version",
    "status",
    "master_refs",
    "breakpoints",
    "design_tokens_ref",
    "component_map_ref",
    "asset_registry_ref",
    "visual_qa"
  ],
  "properties": {
    "handoff_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "accepted",
        "rejected",
        "superseded"
      ]
    },
    "master_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "breakpoints": {
      "type": "object",
      "required": [
        "desktop",
        "tablet",
        "phone"
      ],
      "properties": {
        "desktop": {
          "$ref": "#/$defs/breakpoint"
        },
        "tablet": {
          "$ref": "#/$defs/breakpoint"
        },
        "phone": {
          "$ref": "#/$defs/breakpoint"
        }
      },
      "additionalProperties": false
    },
    "design_tokens_ref": {
      "type": "string",
      "minLength": 1
    },
    "component_map_ref": {
      "type": "string",
      "minLength": 1
    },
    "asset_registry_ref": {
      "type": "string",
      "minLength": 1
    },
    "theme_registry_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "icon_system_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "character_spec_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "motion_spec_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "prototype_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "figma_file_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "asset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "component_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "motion_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/motionRule"
      }
    },
    "visual_qa": {
      "type": "object",
      "required": [
        "baseline_refs",
        "required_viewports"
      ],
      "properties": {
        "baseline_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_viewports": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "known_deviations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "breakpoint": {
      "type": "object",
      "required": [
        "width",
        "frame_ref",
        "composition_mode"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "frame_ref": {
          "type": "string",
          "minLength": 1
        },
        "composition_mode": {
          "type": "string",
          "enum": [
            "full",
            "recomposed",
            "stacked",
            "custom"
          ]
        },
        "hero_crop_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "motionRule": {
      "type": "object",
      "required": [
        "id",
        "owner",
        "trigger",
        "reduced_motion"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "frequency": {
          "type": [
            "string",
            "null"
          ]
        },
        "reduced_motion": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
